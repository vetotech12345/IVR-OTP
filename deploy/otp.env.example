# /etc/otp-service/otp.env  -  chmod 640, owned by root:otp
# Generate each secret with:  openssl rand -hex 32

DB_URL=jdbc:postgresql://localhost:5432/otp_service
DB_USERNAME=otp
DB_PASSWORD=CHANGE_ME

# Keep this one forever: changing it makes every live code fail to verify.
OTP_CODE_PEPPER=CHANGE_ME_64_HEX_CHARS
OTP_ADMIN_TOKEN=CHANGE_ME_64_HEX_CHARS

# Listen only on localhost; nginx is the public face.
PORT=8090
SERVER_ADDRESS=127.0.0.1
# Behind nginx, so the per-IP limit sees the caller's address, not nginx's.
FORWARD_HEADERS=native

# --- Providers: "twilio" sends for real; "log" only writes the code to the log ---
OTP_SMS_PROVIDER=twilio
OTP_WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME
# A Twilio phone number (Console > Phone Numbers), for SMS
TWILIO_SMS_FROM=+1XXXXXXXXXX
# The WhatsApp sender. Trial/testing: the sandbox number +14155238886
TWILIO_WHATSAPP_FROM=+14155238886
# Only needed if either provider above is "log". Never true on a public server.
OTP_SMS_ALLOW_LOG=false
